# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Full Stack FastAPI Project"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Public origin of the frontend. OAuth providers redirect here:
# ${FRONTEND_HOST}/oauth/callback
# Use http://localhost:5173 for the Vite dev server. Production should be the
# public site origin, for example https://example.com
FRONTEND_HOST=http://localhost:5173

# OAuth / OpenID Connect. A provider is enabled only when both its client id
# and client secret are set. Leave them empty to hide that provider.
# Register the redirect URI above with each provider. Do not commit real secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional extra OIDC providers, as a JSON array. Example:
# OIDC_PROVIDERS=[{"id":"auth0","name":"Auth0","client_id":"...","client_secret":"...","discovery_url":"https://example.us.auth0.com/.well-known/openid-configuration"}]
OIDC_PROVIDERS=

# Client certificate (mutual TLS) sign-in. Off unless all of the following are set:
#   MTLS_ENABLED=true
#   a CA in MTLS_CA_FILE (path the API process can read) or MTLS_CA_CERT (PEM text)
#   MTLS_TRUSTED_PROXIES: comma-separated IPs or CIDRs of the reverse proxy
# The API ignores the certificate header from every other address.
# Do not put 127.0.0.1 here on a host whose API port is reachable by anyone else.
# Issue the CA and a client certificate with the openssl commands in development.md.
MTLS_ENABLED=false
MTLS_CA_FILE=
MTLS_CA_CERT=
MTLS_TRUSTED_PROXIES=
MTLS_CLIENT_CERT_HEADER=X-Forwarded-Tls-Client-Cert
# Trust-domain slug stored as external_identity.provider. Subject is the cert fingerprint.
MTLS_PROVIDER=client-ca
# When true, a verified certificate whose SAN or subject email matches one existing
# user is linked on first sign-in. Leave false so only certificates linked from
# Settings can sign in, and so unlinking a certificate stays unlinked.
MTLS_MATCH_EMAIL=false

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
